<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Skeptic.ai - Visual Ad Auditor</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: { 
            brand: { cream: '#FAF9F5', coral: '#FF4B91', yellow: '#FFB800', emerald: '#10B981', dark: '#1E1B18' } 
          },
          boxShadow: { 
            'glow-coral': '0 10px 30px -10px rgba(255, 75, 145, 0.3)', 
            'glow-yellow': '0 10px 30px -10px rgba(255, 184, 0, 0.3)', 
            'glow-emerald': '0 10px 30px -10px rgba(16, 185, 129, 0.3)', 
            'soft': '0 20px 40px -15px rgba(0,0,0,0.05)' 
          }
        }
      }
    }
  </script>

  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>

  <style>
    @keyframes laserScan { 
      0% { top: 0%; opacity: 0.8; } 
      50% { top: 98%; opacity: 1; } 
      100% { top: 0%; opacity: 0.8; } 
    }
    .laser-line { 
      position: absolute; left: 0; right: 0; height: 4px; 
      background: linear-gradient(90deg, transparent, #FF4B91, #FFB800, #FF4B91, transparent); 
      box-shadow: 0 0 15px #FF4B91, 0 0 25px #FF4B91; 
      animation: laserScan 2.5s infinite ease-in-out; z-index: 20; 
    }
  </style>
</head>
<body class="bg-brand-cream text-brand-dark min-h-screen font-sans antialiased selection:bg-brand-coral selection:text-white pb-20">

  <div id="toast" class="fixed bottom-6 right-6 bg-brand-dark text-white px-5 py-3 rounded-2xl shadow-2xl transform translate-y-20 opacity-0 transition-all duration-300 z-50 flex items-center space-x-2 font-medium text-sm">
    <svg class="w-5 h-5 text-brand-emerald" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
    <span id="toast-message">Copied to clipboard!</span>
  </div>

  <header class="max-w-7xl mx-auto px-6 pt-8 pb-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center space-x-3">
      <div class="relative w-12 h-12 bg-white rounded-2xl shadow-glow-coral flex items-center justify-center border-2 border-brand-coral/20">
        <svg class="w-7 h-7 text-brand-coral" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path stroke-linecap="round" d="M20 20l-4.35-4.35"></path></svg>
        <div class="absolute top-4 left-3.5 w-1.5 h-1.5 bg-brand-dark rounded-full"></div>
        <div class="absolute top-4 right-5 w-2 h-0.5 bg-brand-dark rounded-full transform rotate-12"></div>
      </div>
      <div>
        <h1 class="text-2xl font-black tracking-tight text-brand-dark flex items-center gap-1">Skeptic<span class="text-brand-coral">.ai</span></h1>
        <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Stop Launching Blindly.</p>
      </div>
    </div>

    <!-- API Key Entry Box -->
    <div class="flex items-center space-x-2 bg-white p-2 pl-4 rounded-2xl shadow-soft border border-gray-100 w-full sm:w-auto">
      <span class="text-xs font-black text-gray-400 uppercase tracking-wider whitespace-nowrap">API Key:</span>
      <input type="password" id="userApiKey" placeholder="Paste Gemini API Key Here" class="text-xs bg-brand-cream border border-gray-200 rounded-xl px-3 py-2 focus:outline-none focus:border-brand-coral w-full sm:w-64 font-mono">
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-6 mt-4">
    <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-soft border border-gray-100 mb-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <div class="bg-brand-cream p-3 rounded-2xl border border-gray-200/80">
          <label class="block text-xs font-black text-gray-400 uppercase tracking-wider mb-1 pl-1">Creative Format:</label>
          <select id="formatSelect" class="w-full bg-white text-sm font-bold text-brand-dark py-2 px-3 rounded-xl border border-gray-200 focus:outline-none focus:border-brand-coral">
            <option value="image">🖼️ Static Ad Image / Post</option>
            <option value="text">✍️ Written Copy / Hook Text</option>
          </select>
        </div>
        <div class="bg-brand-cream p-3 rounded-2xl border border-gray-200/80">
          <label class="block text-xs font-black text-gray-400 uppercase tracking-wider mb-1 pl-1">Benchmark Niche:</label>
          <select id="industrySelect" class="w-full bg-white text-sm font-bold text-brand-dark py-2 px-3 rounded-xl border border-gray-200 focus:outline-none focus:border-brand-coral">
            <option value="E-commerce">🛒 E-commerce (D2C)</option>
            <option value="SaaS">💻 SaaS & Tech</option>
            <option value="Supplements">🌿 Supplements & Health</option>
            <option value="Info-products">📚 Info-products & Courses</option>
          </select>
        </div>
      </div>

      <div id="textInputWrapper" class="hidden mb-6">
        <label class="block text-xs font-black text-gray-400 uppercase tracking-wider mb-2">Paste Ad Copy Text:</label>
        <textarea id="textCopyInput" rows="4" placeholder="Paste your primary caption, hook variation, or headline copy variations right here..." class="w-full bg-brand-cream p-4 border border-gray-200 rounded-2xl focus:outline-none focus:border-brand-coral font-medium text-sm"></textarea>
      </div>

      <div id="dropZone" class="relative group border-3 border-dashed border-brand-coral/40 hover:border-brand-coral bg-rose-50/30 hover:bg-rose-50/80 rounded-3xl p-10 text-center cursor-pointer transition-all duration-300 flex flex-col items-center justify-center min-h-[200px]">
        <input type="file" id="fileInput" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-30">
        <div class="w-14 h-14 bg-white rounded-2xl shadow-glow-coral flex items-center justify-center mb-3 group-hover:scale-110 group-hover:-translate-y-1 transition-all duration-300">
          <svg class="w-7 h-7 text-brand-coral" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
        </div>
        <p id="uploadPrompt" class="text-sm font-bold text-brand-dark">Drag and drop your ad image here, or <span class="text-brand-coral underline">browse files</span></p>
        <p id="uploadFormatRules" class="text-xs text-gray-400 mt-1">Supports PNG, JPG, WebP up to 10MB</p>
      </div>
    </div>

    <div id="resultsWorkspace" class="hidden space-y-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <div id="previewCard" class="lg:col-span-5 bg-white p-6 rounded-3xl shadow-soft border border-gray-100 flex flex-col items-center justify-center relative overflow-hidden min-h-[260px]">
          <div class="relative w-full rounded-2xl overflow-hidden bg-gray-900 shadow-md">
            <img id="imagePreview" class="w-full h-auto max-h-[380px] object-contain mx-auto block hidden" src="" alt="Ad Preview">
            <div id="laserScan" class="laser-line hidden"></div>
          </div>
          <button id="auditBtn" class="w-full mt-6 bg-brand-coral text-white font-extrabold py-3 rounded-xl shadow-lg shadow-brand-coral/30 hover:scale-[1.02] active:scale-95 transition-all duration-200">Run Omnichannel Audit 🚀</button>
        </div>

        <div class="lg:col-span-7 space-y-6 flex flex-col justify-between">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-white p-6 rounded-3xl shadow-glow-coral border border-rose-100 flex flex-col justify-between">
              <span class="text-xs font-extrabold uppercase tracking-wider text-gray-400">Hook Score</span>
              <div class="my-2"><span id="scoreValue" class="text-5xl font-black text-brand-coral">--</span><span class="text-gray-400 text-lg font-bold">/100</span></div>
              <div class="w-full bg-gray-100 h-2.5 rounded-full overflow-hidden"><div id="scoreBar" class="bg-brand-coral h-full w-0 transition-all duration-1000"></div></div>
            </div>
            <div class="bg-white p-6 rounded-3xl shadow-glow-emerald border border-emerald-100 flex flex-col justify-between">
              <span class="text-xs font-extrabold uppercase tracking-wider text-gray-400">Est. CTR Impact</span>
              <div class="my-2"><span id="ctrValue" class="text-4xl font-black text-brand-emerald">--</span></div>
              <p class="text-xs font-medium text-gray-400">Vs. Industry Benchmark</p>
            </div>
            <div class="bg-white p-6 rounded-3xl shadow-glow-yellow border border-amber-100 flex flex-col justify-between">
              <span class="text-xs font-extrabold uppercase tracking-wider text-gray-400">Friction Index</span>
              <div class="my-2"><span id="clutterValue" class="text-4xl font-black text-brand-yellow">--</span></div>
              <p class="text-xs font-medium text-gray-400">Visual Noise Level</p>
            </div>
          </div>

          <div class="bg-white p-6 rounded-3xl shadow-soft border border-gray-100 flex-1 flex flex-col justify-center min-h-[100px]">
            <h3 class="text-xs font-extrabold uppercase tracking-wider text-brand-coral mb-1">Auditor Verdict</h3>
            <p id="verdictText" class="text-brand-dark font-medium leading-relaxed text-sm">Awaiting asset parsing evaluation...</p>
          </div>

          <div class="bg-white p-6 rounded-3xl shadow-soft border border-gray-100">
            <h3 class="text-xs font-extrabold uppercase tracking-wider text-gray-400 mb-3">Key Core Optimization Fixes</h3>
            <div id="frictionList" class="space-y-2">
              <div class="text-xs text-gray-400 italic">Fix recommendations will appear after running the audit.</div>
            </div>
          </div>
        </div>

      </div>

      <div class="bg-white p-8 rounded-3xl shadow-soft border border-gray-100">
        <h3 class="text-xl font-extrabold text-brand-dark mb-1">✍️ Automated Conversion Copywriting Suite</h3>
        <p class="text-xs text-gray-400 mb-6">Click elements below to copy optimized strings directly to your ad manager.</p>

        <div class="space-y-6">
          <div>
            <span class="text-xs font-extrabold uppercase tracking-wider text-gray-400 block mb-3">Recommended Dynamic Headlines</span>
            <div id="headlinesContainer" class="flex flex-wrap gap-3">
              <div class="text-xs text-gray-400 italic">Headlines will be generated here.</div>
            </div>
          </div>

          <div>
            <span class="text-xs font-extrabold uppercase tracking-wider text-gray-400 block mb-3">Primary Text / Captions Suite</span>
            <div id="bodyCopyBox" class="p-4 rounded-2xl bg-brand-cream border border-gray-200 text-brand-dark text-sm leading-relaxed cursor-pointer hover:border-brand-coral transition-all">
              <span class="text-gray-400 italic">Generated caption text will appear here.</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>

  <script>
    const userApiKeyInput = document.getElementById('userApiKey');
    const formatSelect = document.getElementById('formatSelect');
    const fileInput = document.getElementById('fileInput');
    const dropZone = document.getElementById('dropZone');
    const textInputWrapper = document.getElementById('textInputWrapper');
    const textCopyInput = document.getElementById('textCopyInput');
    const uploadPrompt = document.getElementById('uploadPrompt');
    const uploadFormatRules = document.getElementById('uploadFormatRules');
    const resultsWorkspace = document.getElementById('resultsWorkspace');
    const previewCard = document.getElementById('previewCard');
    const imagePreview = document.getElementById('imagePreview');
    const laserScan = document.getElementById('laserScan');
    const auditBtn = document.getElementById('auditBtn');

    // Auto-load saved key from browser memory
    if (localStorage.getItem('skeptic_gemini_key')) {
      userApiKeyInput.value = localStorage.getItem('skeptic_gemini_key');
    }

    userApiKeyInput.addEventListener('input', () => {
      localStorage.setItem('skeptic_gemini_key', userApiKeyInput.value.trim());
    });

    let assetBase64String = null;
    let fileMimeType = null;

    formatSelect.addEventListener('change', () => {
      const format = formatSelect.value;
      imagePreview.classList.add('hidden'); 

      if (format === 'text') {
        textInputWrapper.classList.remove('hidden'); 
        dropZone.classList.add('hidden'); 
        resultsWorkspace.classList.remove('hidden'); 
        previewCard.classList.add('hidden');
      } else {
        textInputWrapper.classList.add('hidden'); 
        dropZone.classList.remove('hidden'); 
        previewCard.classList.remove('hidden');
        uploadPrompt.innerHTML = 'Drag and drop your ad image here, or <span class="text-brand-coral underline">browse files</span>'; 
        uploadFormatRules.innerText = "Supports PNG, JPG, WebP up to 10MB"; 
        fileInput.accept = "image/*"; 
      }
    });

    fileInput.addEventListener('change', parseUploadedAsset);

    function parseUploadedAsset() {
      const file = fileInput.files[0]; 
      if (!file) return;

      fileMimeType = file.type;
      const reader = new FileReader();

      reader.onload = function(e) {
        assetBase64String = e.target.result.split(',')[1];
        resultsWorkspace.classList.remove('hidden');
        resultsWorkspace.scrollIntoView({ behavior: 'smooth' });

        imagePreview.classList.add('hidden'); 

        if (formatSelect.value === 'image') { 
          imagePreview.src = e.target.result; 
          imagePreview.classList.remove('hidden'); 
        }
      };

      reader.readAsDataURL(file);
    }

    auditBtn.addEventListener('click', runOmnichannelAuditorCall);

    async function runOmnichannelAuditorCall() {
      const apiKey = userApiKeyInput.value.trim();
      const industry = document.getElementById('industrySelect').value;
      const format = formatSelect.value;

      if (!apiKey) {
        alert("Please paste your Gemini API key in the top-right box first!");
        userApiKeyInput.focus();
        return;
      }

      laserScan.classList.remove('hidden');
      auditBtn.disabled = true; 
      auditBtn.innerText = "Processing Assets... 🧠";

      const configurationPrompt = `You are an elite performance marketing analytics router and conversion copywriter. Audit this uploaded ${format} asset tailored to the "${industry}" target market segment. Analyze pacing, clarity, visual noise, hooks, compliance boundaries, or layout syntax. Return execution answers strictly inside a structured JSON validation object with NO markdown formatting: { "score": 82, "ctr": "+18%", "friction": "Moderate Clutter", "verdict": "This asset triggers an immediate conversion hook profile but slightly runs over ideal policy pacing guidelines.", "fixes": ["Adjust CTA color contrast vectors immediately.", "Reduce visual text clutter in the top quadrant."], "headlines": ["Headline variation hook 1", "Headline variation hook 2", "Headline variation hook 3"], "caption": "Primary copy block sequence optimized for launch metrics." }`;

      try {
        let parts = [{ text: configurationPrompt }];
        if (format !== 'text' && assetBase64String) {
          parts.push({ inlineData: { mimeType: fileMimeType, data: assetBase64String } });
        } else if (format === 'text') {
          parts.push({ text: `User Text Data Copy: "${textCopyInput.value}"` });
        }

        const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`, {
          method: 'POST', 
          headers: { 
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ 
            contents: [{ parts: parts }], 
            generationConfig: { responseMimeType: "application/json" } 
          })
        });

        const json = await res.json();
        if (json.error) throw new Error(json.error.message);

        const rawText = json.candidates[0].content.parts[0].text;
        const cleanText = rawText.replace(/```json/g, '').replace(/```/g, '').trim();
        const parsedResult = JSON.parse(cleanText);

        renderDashboardAnalytics(parsedResult);

      } catch (err) {
        alert("API Error: " + err.message);
        console.error(err);
      } finally {
        laserScan.classList.add('hidden'); 
        auditBtn.disabled = false; 
        auditBtn.innerText = "Run Omnichannel Audit 🚀";
      }
    }

    function renderDashboardAnalytics(data) {
      document.getElementById('scoreValue').innerText = data.score;
      document.getElementById('scoreBar').style.width = `${data.score}%`;
      document.getElementById('ctrValue').innerText = data.ctr;
      document.getElementById('clutterValue').innerText = data.friction;
      document.getElementById('verdictText').innerText = data.verdict;

      const fixList = document.getElementById('frictionList'); 
      fixList.innerHTML = '';
      data.fixes.forEach(text => {
        const row = document.createElement('div'); 
        row.className = 'text-xs font-bold text-gray-600 flex items-center space-x-1';
        row.innerHTML = `<span class="text-brand-coral">•</span><span>${text}</span>`; 
        fixList.appendChild(row);
      });

      const hlWrap = document.getElementById('headlinesContainer'); 
      hlWrap.innerHTML = '';
      data.headlines.forEach(text => {
        const pill = document.createElement('div'); 
        pill.className = 'px-3 py-1.5 bg-brand-cream rounded-xl text-xs font-bold border border-gray-200 cursor-pointer hover:border-brand-coral transition-all';
        pill.innerText = text; 
        pill.onclick = () => { navigator.clipboard.writeText(text); showToast("Headline Copied!"); };
        hlWrap.appendChild(pill);
      });

      const bodyBox = document.getElementById('bodyCopyBox'); 
      bodyBox.innerText = data.caption;
      bodyBox.onclick = () => { navigator.clipboard.writeText(data.caption); showToast("Caption Copied!"); };

      if (data.score >= 90 && window.confetti) {
        confetti({ particleCount: 100, spread: 60, origin: { y: 0.7 }, colors: ['#FF4B91', '#FFB800', '#10B981'] });
      }
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      document.getElementById('toast-message').innerText = msg;
      toast.classList.remove('translate-y-20', 'opacity-0');
      setTimeout(() => toast.classList.add('translate-y-20', 'opacity-0'), 2000);
    }

    ['dragenter', 'dragover'].forEach(e => dropZone.addEventListener(e, (ev) => { ev.preventDefault(); dropZone.classList.add('bg-rose-100/50'); }));
    ['dragleave', 'drop'].forEach(e => dropZone.addEventListener(e, (ev) => { ev.preventDefault(); dropZone.classList.remove('bg-rose-100/50'); }));
    dropZone.addEventListener('drop', (e) => { 
      e.preventDefault(); 
      const files = e.dataTransfer.files; 
      if (files.length > 0) { 
        fileInput.files = files; 
        parseUploadedAsset(); 
      } 
    });
  </script>
</body>
</html>
